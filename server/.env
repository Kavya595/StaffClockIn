# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/staffclockin
# Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/staffclockin
MONGODB_URI=mongodb://127.0.0.1:27017/staffclockin

# Secret used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret

# How long an issued token stays valid.
JWT_EXPIRES_IN=7d

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's dev/prod URL).
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
